        <!-- JFreeChart 核心库 -->
        <dependency>
            <groupId>org.jfree</groupId>
            <artifactId>jfreechart</artifactId>
            <version>1.5.4</version> <!-- 使用最新版本 -->
        </dependency>

        <!-- JCommon 库（JFreeChart 的依赖） -->
        <dependency>
            <groupId>org.jfree</groupId>
            <artifactId>jcommon</artifactId>
            <version>1.0.24</version> <!-- 使用最新版本 -->
        </dependency>

        <!-- 图表导出为图像 -->
        <dependency>
            <groupId>org.jfree</groupId>
