<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cn.viewcn.nessusrm.gui.ProgressDialogController"
      alignment="CENTER"
      >

    <!-- 主消息标签 -->
    <Label fx:id="messageLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

    <!-- 进度条 -->
    <ProgressBar fx:id="progressBar" prefWidth="360" progress="0.0" style="-fx-font-size: 12px; -fx-text-fill: #666666;"/>

    <!-- 取消按钮 -->
    <Button fx:id="cancelButton" text="取消" onAction="#handleCancel" style="-fx-padding: 5 15; -fx-font-size: 12px;"/>

</VBox>